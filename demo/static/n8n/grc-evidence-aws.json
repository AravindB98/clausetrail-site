      "id": "9246660b-1409-50e0-99ea-7414cd168632",
      "name": "Get credential report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The report arrives base64-encoded inside the response (JSON or XML). Keep only what the checks test.\nconst find = (o) => { if (!o || typeof o !== 'object') return null; if (typeof o.Content === 'string') return o.Content; for (const k of Object.keys(o)) { const r = find(o[k]); if (r) return r; } return null; };\nconst raw = $input.first().json;\nlet b64 = find(raw);\nif (!b64) { const m = JSON.stringify(raw).match(/<Content>([^<]+)<\\/Content>/); b64 = m && m[1]; }\nif (!b64) throw new Error('No credential report in the AWS response. If the report was still being generated, run again.');\nconst lines = Buffer.from(b64, 'base64').toString('utf8').trim().split('\\n');\nconst head = lines.shift().split(',');\nconst now = Date.now();\nconst age = (v) => (!v || ['N/A', 'not_supported', 'no_information'].includes(v)) ? null : Math.floor((now - Date.parse(v)) / 86400000);\nconst items = lines.map(l => { const c = l.split(','); const r = Object.fromEntries(head.map((h, i) => [h, c[i]]));\n  const root = r.user === '<root_account>';\n  const ages = [1, 2].filter(n => r['access_key_' + n + '_active'] === 'true').map(n => age(r['access_key_' + n + '_last_rotated'])).filter(a => a !== null);\n  return { user: r.user, is_root: root, password_enabled: !root && r.password_enabled === 'true', mfa_active: r.mfa_active === 'true', has_active_key: ages.length > 0, oldest_key_age_days: ages.length ? Math.max(...ages) : null }; });\nreturn [{ json: { checks: ['aws_iam_user_mfa', 'aws_root_mfa', 'aws_access_key_age'], source_ref: 'AWS account ' + $('Settings').first().json.account + ' (n8n)', items } }];"
      },
      "id": "21f3fd29-cf61-59cd-a3fc-b8a1148f7a2e",
      "name": "Shape users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
