    {
      "parameters": {
        "content": "## GRC evidence: AWS IAM\n1. Edit **Settings**.\n2. On the two AWS nodes choose an **AWS** credential for an IAM user or role that has only `iam:GenerateCredentialReport` and `iam:GetCredentialReport`.\n3. On *Send users to GRC* choose a **Header Auth** credential: Name `Authorization`, Value `Bearer <GRC API token>`.\n4. Import and run one copy of this workflow per AWS account.",
        "height": 260,
        "width": 520
      },
      "id": "9be16725-e370-5142-9b01-800a49f4764d",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -20
      ]
    }
